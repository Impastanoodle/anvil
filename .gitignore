# per-machine permission grants, not shared
.claude/settings.local.json
# head-run lock, per machine
HEAD.lock
# scratch
*.tmp
*.log
# OpenCascade experiment: the 64 MB opencascade.js package is fetched by anvil/vendor/get-occt.ps1, not committed
anvil/vendor/occt/opencascade.full.*
# LibreDWG (DXF to DWG fallback converter, 35 MB) is fetched by anvil/vendor/get-libredwg.ps1, not committed
anvil/vendor/libredwg/
# the head session's live subagent registry (agent ids, per session)
head-tools/agents.local.json
__pycache__/
# the Windows app (desktop/): its packages, the staged copy of anvil/ with the engine, and the built installers
desktop/node_modules/
desktop/stage/
desktop/dist/
# the native OpenCascade addon (desktop/native): node-gyp's build folder and its npm packages; OpenCascade itself and
# the collected addon live in Desktop\Output\Anvil Native, outside the repository
desktop/native/build/
desktop/native/node_modules/
